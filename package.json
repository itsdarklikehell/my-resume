{
  "name": "my-resume-improve",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint script.js sw.js src/**/*.js",
    "lint:fix": "eslint --fix script.js sw.js src/**/*.js",
    "lint:html": "html-validate --config .htmlvalidate.json index.html 404.html",
    "lint:css": "stylelint styles.css --config .stylelintrc.json",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write script.js sw.js src/**/*.js styles.css",
    "format:check": "prettier --check script.js sw.js src/**/*.js styles.css",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm run lint:html && npm run lint:css && npm test && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "globals": "^15.14.0",
    "html-validate": "9.7.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "stylelint": "16.10.0",
    "stylelint-config-standard": "36.0.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
